# Put actual values in private environment settings, never in GitHub.
HUANCHANG_PUBLIC_ORIGIN=https://your-site.vercel.app
# Optional stable Preview alias; applies only in Vercel Preview.
HUANCHANG_PREVIEW_ORIGIN=
HUANCHANG_DATABASE_URL=postgresql://APP_USER.PROJECT_REF@POOLER_HOST:6543/postgres?sslmode=require
# Enter the database password separately; punctuation is encoded automatically.
HUANCHANG_DATABASE_PASSWORD=
HUANCHANG_SUPABASE_URL=https://PROJECT_REF.supabase.co
HUANCHANG_SUPABASE_SERVICE_KEY=
HUANCHANG_STORAGE_BUCKET=huanchang-media
HUANCHANG_SMTP_HOST=
HUANCHANG_SMTP_PORT=587
HUANCHANG_MAIL_FROM=
HUANCHANG_SMTP_USER=
HUANCHANG_SMTP_PASSWORD=
HUANCHANG_SMTP_TLS=starttls
